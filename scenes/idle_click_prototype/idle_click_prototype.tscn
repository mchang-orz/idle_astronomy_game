[sub_resource type="GDScript" id="GDScript_ej6a4"]
script/source = "extends Label

func _ready() -> void:
	update_text()
	ManagerStars.ref.stars_created.connect(_on_stars_created)
	
func update_text() -> void:
	text = \"STARS: %s\" %ManagerStars.ref.get_stars()
	
func _on_stars_created(quant : int) -> void:
	update_text()
"

[sub_resource type="GDScript" id="GDScript_boi1d"]
resource_name = "button"
script/source = "extends TextureButton

func _on_pressed() -> void:
	ManagerClick.ref.click()
"

[sub_resource type="GDScript" id="GDScript_1pde7"]
script/source = "extends CheckButton

func _ready() -> void:
	disabled = true
	
func _process(_delta: float) -> void:
	if ManagerStars.ref.get_stars() >= ManagerUpgrades.ref.passivegen_cost:
		disabled = false
		print(ManagerStars.ref.get_stars() - ManagerUpgrades.ref.passivegen_cost)
		
func upgrade_bought() -> void:
	var total = ManagerStars.ref.get_stars()
	var newtotal = total - ManagerUpgrades.ref.passivegen_cost
	if newtotal < 0:
		ManagerStars.ref.stars = 0
	else:
		ManagerStars.ref.stars = newtotal

#unlocks passive star gen
func _on_toggled(toggled_on: bool) -> void:
	if toggled_on == true:
		Game.ref.data.upgrade_passive = true
		print(\"upgrade status: \", Game.ref.data.upgrade_passive)
		PassiveGenerator.ref._start_generator()
	else:
		Game.ref.data.upgrade_passive = false
		print(\"upgrade status: \", Game.ref.data.upgrade_passive)
		PassiveGenerator.ref._start_generator()


func _on_pressed() -> void:
	if ManagerStars.ref.get_stars() < ManagerUpgrades.ref.passivegen_cost :
		print(\"cannot buy!\")
		return
	print(\"upgrade bought\")
	disabled = true
	upgrade_bought()
"

